# Application Environment
NODE_ENV=development
PORT=5000

# Database (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://postgres:password@localhost:5432/portfolio_db?schema=public"

# Redis Cache (Local or Cloud Redis)
REDIS_URL="redis://localhost:6379"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="your_super_secret_jwt_access_key"
JWT_REFRESH_SECRET="your_super_secret_jwt_refresh_key"
JWT_TEMP_SECRET="your_super_secret_jwt_temp_key"

# SMTP Mail Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

