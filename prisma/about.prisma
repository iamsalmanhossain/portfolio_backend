model About {
  id String @id @default(uuid())

  name        String
  headline    String
  shortBio    String
  description String

  profileImage String?
  resumeUrl    String?

  location     String?
  email        String?
  availability Boolean @default(true)

  experienceYears Int @default(0)
  projectsCount   Int @default(0)
  clientsCount    Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("about")
}
